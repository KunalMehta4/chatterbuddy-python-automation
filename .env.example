# Copy this file to .env and edit as needed:
#     cp .env.example .env
#
# Every setting is optional. With no .env at all, ChatterBuddy runs with
# sensible defaults and both API-backed commands still work.

# ---------------------------------------------------------------------------
# Web search (optional)
# ---------------------------------------------------------------------------
# Without a key, `search` uses the Wikipedia API, which needs no credentials.
# Set a Tavily key to switch to general web search. Tavily's free plan grants
# monthly credits and does not require a card: https://tavily.com
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Weather
# ---------------------------------------------------------------------------
# No key is needed. Weather comes from Open-Meteo, which is free for
# non-commercial use without registration.

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# metric  -> degrees Celsius and km/h
# imperial -> degrees Fahrenheit and mph
CHATTERBUDDY_UNITS=metric

# Where the JSON data files live. Defaults to ./data
CHATTERBUDDY_DATA_DIR=

# Seconds to wait for an API response before giving up.
CHATTERBUDDY_HTTP_TIMEOUT=8

# How many search results to print.
CHATTERBUDDY_SEARCH_RESULTS=5

# How often the background thread checks for due alarms, in seconds.
CHATTERBUDDY_ALARM_POLL_SECONDS=15
